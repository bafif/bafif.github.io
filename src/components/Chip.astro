---
import { pinout } from "../data/profile";
import type { Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// DIP-16 drawn as a datasheet "pin configuration" figure, in the brand's colors.
const perSide = pinout.length / 2;
const pitch = 30;
const bodyX = 150;
const bodyW = 120;
const top = 30;
const bodyH = perSide * pitch + 10;
const pinLen = 18;
const width = bodyX * 2 + bodyW;
const height = top * 2 + bodyH;

const left = pinout.slice(0, perSide).map((label, i) => ({
  label,
  n: i + 1,
  y: top + 20 + i * pitch,
}));
const right = pinout.slice(perSide).map((label, i) => ({
  label,
  n: perSide + i + 1,
  y: top + 20 + (perSide - 1 - i) * pitch,
}));
const isPower = (label: string) => label === "GND" || label === "VCC";
const mark = 34;
---

<figure class="chip" data-vivo>
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby="chip-title">
    <title id="chip-title">
      {lang === "es" ? "Diagrama de pines con las tecnologías que uso" : "Pin diagram with the technologies I use"}: {pinout.join(", ")}
    </title>

    {
      [...left.map((pin) => ({ ...pin, side: "l" })), ...right.map((pin) => ({ ...pin, side: "r" }))].map((pin) => (
        <g>
          <rect
            x={pin.side === "l" ? bodyX - pinLen : bodyX + bodyW}
            y={pin.y - 4}
            width={pinLen}
            height="8"
            class:list={["pata", isPower(pin.label) && "pata-energia"]}
            style={`--n:${pin.n - 1}`}
          />
          <text
            x={pin.side === "l" ? bodyX - pinLen - 8 : bodyX + bodyW + pinLen + 8}
            y={pin.y + 4}
            text-anchor={pin.side === "l" ? "end" : "start"}
            class="nombre"
          >
            {pin.label}
          </text>
          <text
            x={pin.side === "l" ? bodyX + 9 : bodyX + bodyW - 9}
            y={pin.y + 3.5}
            text-anchor={pin.side === "l" ? "start" : "end"}
            class="numero"
          >
            {pin.n}
          </text>
        </g>
      ))
    }

    <rect x={bodyX} y={top} width={bodyW} height={bodyH} rx="4" class="cuerpo" />
    <path d={`M ${bodyX + bodyW / 2 - 12} ${top} a 12 12 0 0 0 24 0`} class="muesca" />
    <circle cx={bodyX + 22} cy={top + 20} r="3" class="punto" />
    <g transform={`translate(${bodyX + bodyW / 2} ${top + bodyH / 2 - 14}) rotate(-90)`}>
      <text text-anchor="middle" class="marca">BF-2026</text>
      <text y="16" text-anchor="middle" class="origen">ROSARIO · AR</text>
    </g>
    <image
      href="/marca/emblema-claro.svg"
      x={bodyX + bodyW / 2 - mark / 2}
      y={top + bodyH - mark - 16}
      width={mark}
      height={mark}
      class="solo-claro"
    />
    <image
      href="/marca/emblema-oscuro.svg"
      x={bodyX + bodyW / 2 - mark / 2}
      y={top + bodyH - mark - 16}
      width={mark}
      height={mark}
      class="solo-oscuro"
    />
  </svg>
  <figcaption>Fig. 1 — {lang === "es" ? "Configuración de pines, vista superior" : "Pin configuration, top view"}</figcaption>
</figure>

<style>
  .chip svg {
    display: block;
    width: 100%;
    max-width: 420px;
    margin-inline: auto;
    font-family: var(--f-mono);
  }

  /* Pins in the brand's accent (blue by day, Newell's red by night); power pins in the sun's gold. */
  .pata {
    --pata-fill: var(--acento);
    fill: var(--pata-fill);
  }

  .pata-energia {
    --pata-fill: var(--sol);
  }

  /* A signal runs around the chip in pin order every few seconds: each pin flashes the other pin color. */
  @media (prefers-reduced-motion: no-preference) {
    .pata {
      --destello: var(--sol);
      animation: senal 6s linear infinite;
      animation-delay: calc(0.8s + var(--n) * 0.14s);
    }

    .pata-energia {
      --destello: var(--acento);
    }
  }

  @keyframes senal {
    0%,
    9% {
      fill: var(--destello);
    }
    16% {
      fill: var(--pata-fill);
    }
  }

  .nombre {
    font-size: 12px;
    fill: var(--texto);
  }

  .numero {
    font-size: 10px;
    fill: var(--texto-3);
  }

  .cuerpo {
    fill: var(--superficie-2);
    stroke: var(--texto);
    stroke-width: 1.5;
  }

  .muesca {
    fill: var(--superficie);
    stroke: var(--texto);
    stroke-width: 1.5;
  }

  .punto {
    fill: var(--texto);
    opacity: 0.5;
  }

  .marca {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 2px;
    fill: var(--texto);
  }

  .origen {
    font-size: 9px;
    letter-spacing: 1.5px;
    fill: var(--texto-3);
  }

  figcaption {
    margin-top: 0.75rem;
    text-align: center;
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    color: var(--texto-3);
  }
</style>
