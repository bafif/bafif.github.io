---
import { pinout } from "../data/profile";

// DIP-16 drawn as a datasheet "pin configuration" figure.
const perSide = pinout.length / 2;
const pitch = 30;
const bodyX = 150;
const bodyW = 120;
const top = 30;
const bodyH = perSide * pitch + 10;
const pinLen = 18;
const width = bodyX * 2 + bodyW;
const height = top * 2 + bodyH;

const left = pinout.slice(0, perSide).map((label, i) => ({
  label,
  n: i + 1,
  y: top + 20 + i * pitch,
}));
const right = pinout.slice(perSide).map((label, i) => ({
  label,
  n: perSide + i + 1,
  y: top + 20 + (perSide - 1 - i) * pitch,
}));
const isPower = (label: string) => label === "GND" || label === "VCC";
---

<figure class="w-full">
  <svg
    viewBox={`0 0 ${width} ${height}`}
    class="mx-auto w-full max-w-[420px] font-mono"
    role="img"
    aria-labelledby="chip-title"
  >
    <title id="chip-title">Diagrama de pines con las tecnologías que uso: {pinout.join(", ")}</title>

    {
      left.map((pin) => (
        <g>
          <rect
            x={bodyX - pinLen}
            y={pin.y - 4}
            width={pinLen}
            height="8"
            fill={isPower(pin.label) ? "var(--trace)" : "var(--accent)"}
          />
          <text x={bodyX - pinLen - 8} y={pin.y + 4} text-anchor="end" font-size="12" fill="var(--ink)">
            {pin.label}
          </text>
          <text x={bodyX + 9} y={pin.y + 3.5} font-size="10" fill="var(--muted)">
            {pin.n}
          </text>
        </g>
      ))
    }
    {
      right.map((pin) => (
        <g>
          <rect
            x={bodyX + bodyW}
            y={pin.y - 4}
            width={pinLen}
            height="8"
            fill={isPower(pin.label) ? "var(--trace)" : "var(--accent)"}
          />
          <text x={bodyX + bodyW + pinLen + 8} y={pin.y + 4} font-size="12" fill="var(--ink)">
            {pin.label}
          </text>
          <text x={bodyX + bodyW - 9} y={pin.y + 3.5} text-anchor="end" font-size="10" fill="var(--muted)">
            {pin.n}
          </text>
        </g>
      ))
    }

    <rect x={bodyX} y={top} width={bodyW} height={bodyH} rx="4" fill="var(--surface)" stroke="var(--ink)" stroke-width="1.5" />
    <path
      d={`M ${bodyX + bodyW / 2 - 12} ${top} a 12 12 0 0 0 24 0`}
      fill="var(--paper)"
      stroke="var(--ink)"
      stroke-width="1.5"
    />
    <circle cx={bodyX + 22} cy={top + 20} r="3" fill="var(--ink)" opacity="0.5" />
    <g transform={`translate(${bodyX + bodyW / 2} ${top + bodyH / 2}) rotate(-90)`}>
      <text text-anchor="middle" font-size="15" font-weight="500" fill="var(--ink)" letter-spacing="2">BF-2026</text>
      <text y="16" text-anchor="middle" font-size="9" fill="var(--muted)" letter-spacing="1.5">ROSARIO · AR</text>
    </g>
  </svg>
  <figcaption class="mt-3 text-center font-mono text-xs text-muted">
    Fig. 1 — Configuración de pines, vista superior
  </figcaption>
</figure>
