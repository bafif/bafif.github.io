---
import { profile } from "../data/profile";

const year = new Date().getFullYear();
---

<footer class="pie">
  <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <p class="flex items-center gap-2.5">
      <img src="/marca/emblema-claro.svg" alt="" width="20" height="20" class="solo-claro size-5" />
      <img src="/marca/emblema-oscuro.svg" alt="" width="20" height="20" class="solo-oscuro size-5" />
      © {year} {profile.fullName} · {profile.location}
    </p>
    <ul class="flex flex-wrap gap-x-5 gap-y-2">
      <li><a href={profile.github}>GitHub</a></li>
      <li><a href={`mailto:${profile.email}`}>Correo</a></li>
      <li><a href="/donaciones/">Donaciones</a></li>
      <li><a href="/privacy/">Privacidad</a></li>
    </ul>
  </div>
</footer>

<style>
  /* The stripes go in a thin band on top, never behind the small text. */
  .pie {
    position: relative;
    background: var(--superficie-2);
  }

  .pie::before {
    content: "";
    display: block;
    height: 6px;
    /* Sky blue against deep blue, apart by lightness (sky blue and white look alike in protanopia). */
    background: repeating-linear-gradient(90deg, var(--celeste) 0 22px, var(--azul) 22px 44px);
  }

  :global(:root[data-tema="oscuro"]) .pie::before {
    background: repeating-linear-gradient(90deg, var(--rojo-boton) 0 22px, var(--negro) 22px 44px);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-tema="claro"])) .pie::before {
      background: repeating-linear-gradient(90deg, var(--rojo-boton) 0 22px, var(--negro) 22px 44px);
    }
  }
</style>
