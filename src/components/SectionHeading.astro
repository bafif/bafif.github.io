---
interface Props {
  index: string;
  title: string;
  kicker?: string;
}

const { index, title, kicker } = Astro.props;
---

<div class="mb-10 max-w-3xl sm:mb-12">
  <p class="rotulo"><span class="text-accent-text">{index}</span> · {title}</p>
  <h2 class="mt-3 text-[clamp(2rem,4.5vw,3rem)]"><slot>{title}</slot></h2>
  {kicker && <p class="mt-4 text-lg text-muted">{kicker}</p>}
</div>
