---
interface Props {
  index: string;
  title: string;
  kicker?: string;
}

const { index, title, kicker } = Astro.props;
---

<div class="mb-8 flex flex-col gap-2 border-b border-rule pb-4 sm:mb-10 sm:flex-row sm:items-end sm:justify-between">
  <h2 class="flex items-baseline gap-3 text-2xl font-semibold tracking-tight sm:text-3xl">
    <span class="font-mono text-sm font-medium text-accent">{index}</span>
    {title}
  </h2>
  {kicker && <p class="max-w-md text-sm text-muted sm:text-right">{kicker}</p>}
</div>
