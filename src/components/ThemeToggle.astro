---
import { t, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  class="grid size-9 place-items-center rounded-full text-muted transition-colors hover:bg-surface-2 hover:text-ink"
  aria-label={t[lang].tema}
>
  <svg viewBox="0 0 24 24" class="size-[18px]" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <circle cx="12" cy="12" r="8.5"></circle>
    <path d="M12 3.5a8.5 8.5 0 0 1 0 17Z" fill="currentColor"></path>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const media = window.matchMedia("(prefers-color-scheme: dark)");

  function current(): "claro" | "oscuro" {
    const explicit = root.dataset.tema;
    if (explicit === "claro" || explicit === "oscuro") return explicit;
    return media.matches ? "oscuro" : "claro";
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
    button.addEventListener("click", () => {
      const next = current() === "oscuro" ? "claro" : "oscuro";
      root.dataset.tema = next;
      try {
        localStorage.setItem("tema", next);
        localStorage.removeItem("theme");
      } catch {}
    });
  }
</script>
