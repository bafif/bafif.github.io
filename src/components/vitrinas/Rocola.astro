---
import type { Showcase } from "../../data/projects";
import Vitrina from "./Vitrina.astro";
import { localize, type Lang } from "../../i18n";
import RocolaPantalla from "./RocolaPantalla.astro";

interface Props {
  project: Showcase;
  lang: Lang;
  index: number;
  flip?: boolean;
}

const { project, lang, index, flip } = Astro.props;
const [playing, ...selectors] = project.images;
const s = localize(
  {
    epocas: [
      { es: "fines de los 40", en: "late '40s" },
      { es: "mediados de los 50", en: "mid-'50s" },
      { es: "los 60 y 70", en: "the '60s and '70s" },
      { es: "los 80", en: "the '80s" },
    ],
    tarjetas: { es: "Arranque y pantallas", en: "Boot and displays" },
    nota: {
      es:
        "Arriba, Reproduciendo con Ámbar, en movimiento como va a verse; abajo, el selector en los cuatro temas de época. " +
        "Ámbar, el que viene por defecto, llega con la v0.1.2.",
      en:
        "Above, the now-playing screen in Ámbar, moving as it is going to look; below, the selector in the four period " +
        "themes. Ámbar, the default, arrives with v0.1.2.",
    },
  },
  lang,
);
const eras = ["Ámbar", "Cromo", "Neón", "Display"].map((name, i) => [name, s.epocas[i]]);
// Selection codes, like the title strips of a jukebox.
const cards = [
  ["A1", "BIOS + UEFI"],
  ["A2", "VGA 31 kHz"],
  ["B1", "Arcade 15 kHz"],
  ["B2", "Debian i386"],
];
---

<Vitrina project={project} lang={lang} index={index} flip={flip} visible={4}>
  <ul slot="firma" class="rc-tarjetas" aria-label={s.tarjetas}>
    {
      cards.map(([code, label]) => (
        <li>
          <b>{code}</b>
          <span>{label}</span>
        </li>
      ))
    }
  </ul>

  <Fragment slot="muestra">
    <RocolaPantalla label={playing.alt} lang={lang} />
    <div class="rc-temas">
      {
        selectors.map((image, i) => (
          <figure>
            <img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" />
            <figcaption>
              <b>{eras[i][0]}</b> · {eras[i][1]}
            </figcaption>
          </figure>
        ))
      }
    </div>
    <p class="rc-nota">{s.nota}</p>
  </Fragment>
</Vitrina>
