---
import type { Showcase } from "../../data/projects";
import Vitrina from "./Vitrina.astro";

interface Props {
  project: Showcase;
  index: number;
  flip?: boolean;
}

const { project, index, flip } = Astro.props;
const [egypt, world] = project.images;
---

<Vitrina project={project} index={index} flip={flip}>
  <div slot="firma" class="tm-tiempo" aria-hidden="true">
    <div class="tm-regla"><span class="tm-cursor"></span></div>
    <div class="tm-extremos"><span>3400 a. C.</span><span class="tm-ahora">1350 a. C.</span><span>2024</span></div>
  </div>

  <Fragment slot="muestra">
    <figure>
      <div class="tm-marco">
        <span class="tm-esquina"></span><span class="tm-esquina"></span><span class="tm-esquina"></span><span class="tm-esquina"
        ></span>
        <span class="tm-lente"><img src={egypt.src} alt={egypt.alt} width={egypt.width} height={egypt.height} loading="lazy" decoding="async" /></span>
      </div>
      <figcaption>Egipto en 1350 a. C., con lo que se escribió ahí en esa época: las Cartas de Amarna y el Gran Himno a Atón.</figcaption>
    </figure>
    <figure class="mt-7 hidden sm:block">
      <div class="tm-marco">
        <span class="tm-esquina"></span><span class="tm-esquina"></span><span class="tm-esquina"></span><span class="tm-esquina"
        ></span>
        <span class="tm-lente"><img src={world.src} alt={world.alt} width={world.width} height={world.height} loading="lazy" decoding="async" /></span>
      </div>
      <figcaption>El mundo en 117 d. C., con el Imperio romano en su máxima extensión.</figcaption>
    </figure>
  </Fragment>
</Vitrina>
