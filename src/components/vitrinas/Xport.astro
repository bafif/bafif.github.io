---
import type { Showcase } from "../../data/projects";
import Vitrina from "./Vitrina.astro";

interface Props {
  project: Showcase;
  index: number;
  flip?: boolean;
}

const { project, index, flip } = Astro.props;
const [popup] = project.images;
---

<Vitrina project={project} index={index} flip={flip} visible={2}>
  <img slot="logo" class="v-logo" src="/img/proyectos/xport-logo.svg" alt="" width="52" height="52" />

  <Fragment slot="firma">
    <code class="xp-consulta"><b>from:cuenta</b> 2026-01-01 → 2026-06-30 <span>↗ cuenta.csv</span></code>
    <p class="xp-promesa">No puede pasar el tope de los términos de X.</p>
  </Fragment>

  <div slot="muestra" class="xp-popup">
    <img src={popup.src} alt={popup.alt} width={popup.width} height={popup.height} loading="lazy" decoding="async" />
  </div>
</Vitrina>
