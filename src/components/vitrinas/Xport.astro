---
import type { Showcase } from "../../data/projects";
import Vitrina from "./Vitrina.astro";
import { localize, type Lang } from "../../i18n";

interface Props {
  project: Showcase;
  lang: Lang;
  index: number;
  flip?: boolean;
}

const { project, lang, index, flip } = Astro.props;
const [popup] = project.images;
// The query as xport's popup shows it, in the page's language.
const s = localize(
  {
    cuenta: { es: "cuenta", en: "account" },
    promesa: { es: "No puede pasar el tope de los términos de X.", en: "It can't go over the cap in X's terms." },
  },
  lang,
);
---

<Vitrina project={project} lang={lang} index={index} flip={flip} visible={2}>
  <img slot="logo" class="v-logo" src="/img/proyectos/xport-logo.svg" alt="" width="52" height="52" />

  <Fragment slot="firma">
    <code class="xp-consulta"><span class="xp-tecleo"><b>from:{s.cuenta}</b> 2026-01-01 → 2026-06-30 <span>↗ {s.cuenta}.csv</span></span></code>
    <p class="xp-promesa">{s.promesa}</p>
  </Fragment>

  <div slot="muestra" class="xp-popup">
    <img src={popup.src} alt={popup.alt} width={popup.width} height={popup.height} loading="lazy" decoding="async" />
  </div>
</Vitrina>
