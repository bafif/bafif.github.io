---
// GitHub Pages serves this one page for every missing address, in either language: it carries both texts and shows
// the one Base.astro's script picked (data-idioma); without JavaScript, the Spanish one.
import Base from "../layouts/Base.astro";
import { localize, langs, routes } from "../i18n";

const texts = langs.map((lang) => ({
  lang,
  ...localize(
    {
      titulo: { es: "Esta página no existe", en: "This page doesn't exist" },
      texto: {
        es: "Puede que el enlace esté roto o que la página se haya movido.",
        en: "The link may be broken, or the page may have moved.",
      },
      volver: { es: "Volver al inicio", en: "Back to the home page" },
    },
    lang,
  ),
}));
---

<Base title="Página no encontrada · Page not found · Bautista Fiori" description="La página que buscás no existe. The page you are looking for doesn't exist." lang="es">
  <section class="mx-auto max-w-2xl px-4 py-24 text-center sm:px-6">
    <p class="font-mono text-sm text-accent-text">Error 404</p>
    {
      texts.map((s) => (
        <div lang={s.lang} class={`solo-${s.lang}`}>
          <h1 class="mt-3 text-4xl font-semibold tracking-tight">{s.titulo}</h1>
          <p class="mt-4 text-muted">{s.texto}</p>
          <a
            href={routes.inicio[s.lang]}
            class="mt-8 inline-block rounded border border-ink px-4 py-2.5 text-sm font-medium hover:bg-ink hover:text-paper"
          >
            {s.volver}
          </a>
        </div>
      ))
    }
  </section>
</Base>

<style>
  :global(:root:not([data-idioma="en"])) .solo-en,
  :global(:root[data-idioma="en"]) .solo-es {
    display: none;
  }
</style>
