---
import Base from "../layouts/Base.astro";
---

<Base title="Página no encontrada · Bautista Fiori" description="La página que buscás no existe.">
  <section class="mx-auto max-w-2xl px-4 py-24 text-center sm:px-6">
    <p class="font-mono text-sm text-accent">Error 404</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight">Esta página no existe</h1>
    <p class="mt-4 text-muted">Puede que el enlace esté roto o que la página se haya movido.</p>
    <a href="/" class="mt-8 inline-block rounded border border-ink px-4 py-2.5 text-sm font-medium hover:bg-ink hover:text-paper">Volver al inicio</a>
  </section>
</Base>
