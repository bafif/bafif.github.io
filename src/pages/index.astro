---
import Base from "../layouts/Base.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Indice from "../components/Indice.astro";
import TellMap from "../components/vitrinas/TellMap.astro";
import Urna from "../components/vitrinas/Urna.astro";
import Xport from "../components/vitrinas/Xport.astro";
import Foja from "../components/vitrinas/Foja.astro";
import Rocola from "../components/vitrinas/Rocola.astro";
import Pocket from "../components/vitrinas/Pocket.astro";
import { profile } from "../data/profile";
import { showcases, smallProjects } from "../data/projects";
import { education, experience, timeline } from "../data/career";

const skins = { tellmap: TellMap, urna: Urna, xport: Xport, foja: Foja, rocola: Rocola, pocket: Pocket } as const;
---

<Base
  title="Bautista Fiori · Portfolio"
  description="Técnico electrónico y estudiante de Ciencias de la Computación e IA en Rosario. Un atlas histórico, una app para fiscales, un editor de CV, una rocola booteable y más."
>
  <!-- Hero -->
  <section class="portada">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-[1.35fr_1fr]">
      <div>
        <p class="rotulo">Portfolio · {profile.location}</p>
        <h1 class="mt-4 text-[clamp(3rem,9vw,5.75rem)]">Bautista <em>Fiori</em></h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted sm:text-xl">{profile.lead}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#proyectos" class="boton boton-principal">Ver proyectos</a>
          <a href={profile.github} class="boton">GitHub <span aria-hidden="true">↗</span></a>
          <a href={`mailto:${profile.email}`} class="boton">Escribime</a>
        </div>
        <ul class="mt-12 grid max-w-xl gap-x-6 gap-y-2.5 sm:grid-cols-2">
          {
            profile.features.map((feature) => (
              <li class="flex gap-2.5 text-[15px] leading-snug">
                <span aria-hidden="true" class="text-accent-text">✓</span>
                {feature}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="sol" aria-hidden="true">
        <img src="/marca/emblema-claro.svg" alt="" width="360" height="360" class="solo-claro" />
        <img src="/marca/emblema-oscuro.svg" alt="" width="360" height="360" class="solo-oscuro" />
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section id="proyectos" class="mx-auto max-w-6xl px-4 pt-16 pb-14 sm:px-6 sm:pt-24">
    <SectionHeading
      index="01"
      title="Proyectos"
      kicker="Del arranque de una PC de 32 bits a un atlas de la historia. Cada proyecto se muestra con su propia estética y con capturas reales."
    />
    <Indice />
  </section>

  {
    showcases.map((project, i) => {
      const Skin = skins[project.skin];
      return <Skin project={project} index={i + 1} flip={i % 2 === 1} />;
    })
  }

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <p class="rotulo">También</p>
    <h2 class="mt-3 text-[clamp(1.75rem,3.5vw,2.25rem)]">Prototipos y aportes</h2>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        smallProjects.map((p) => (
          <li>
            <a href={p.href} class="llano chico">
              <span class="rotulo">
                {p.status} · {p.year}
              </span>
              <span class="chico-nombre">
                {p.name} <span aria-hidden="true">↗</span>
              </span>
              <span class="chico-lema">{p.tagline}</span>
              <span class="chico-texto">{p.description}</span>
              <span class="chico-stack">{p.stack.join(" · ")}</span>
            </a>
          </li>
        ))
      }
      <li>
        <a href={profile.github} class="llano chico chico-mas">
          <span class="rotulo">En curso</span>
          <span class="chico-nombre">Más en GitHub <span aria-hidden="true">↗</span></span>
          <span class="chico-texto">Experimentos, forks y lo que esté armando ahora.</span>
        </a>
      </li>
    </ul>
  </section>

  <!-- Timeline -->
  <section id="recorrido" class="franja">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
      <SectionHeading index="02" title="Recorrido" kicker="Años de hacer cosas, de reparar la primera PC hasta hoy." />
      <ol class="relative grid gap-8 md:grid-cols-5 md:gap-6">
        <span aria-hidden="true" class="absolute top-[7px] right-0 left-0 hidden h-px bg-rule-strong md:block"></span>
        {
          timeline.map((milestone) => (
            <li class="relative pl-6 md:pl-0">
              <span aria-hidden="true" class="hito absolute top-[3px] left-0 md:relative md:top-0 md:block" />
              <p class="font-serif text-2xl font-semibold text-accent-text md:mt-4">{milestone.year}</p>
              <ul class="mt-2 space-y-1.5 text-[15px] leading-snug">
                {milestone.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Experience & education -->
  <section id="experiencia" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
    <SectionHeading index="03" title="Experiencia y formación" />
    <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr]">
      <div class="flex flex-col divide-y divide-rule">
        {
          experience.map((role) => (
            <article class="py-6 first:pt-0">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <h3 class="text-xl">
                  {role.title}
                  {role.place && <span class="text-muted"> · {role.place}</span>}
                </h3>
                <p class="font-mono text-xs text-faint">{role.period}</p>
              </div>
              <p class="rotulo mt-1.5">{role.kind}</p>
              <ul class="mt-3 space-y-1.5 text-[15px] leading-relaxed">
                {role.items.map((item) => (
                  <li class="flex gap-3">
                    <span aria-hidden="true" class="mt-[9px] size-1.5 shrink-0 rotate-45 bg-rule-strong" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>

      <div class="flex flex-col gap-10">
        <div>
          <h3 class="rotulo">Formación</h3>
          <ul class="mt-4 space-y-5">
            {
              education.map((study) => (
                <li class="border-l-2 border-accent pl-4">
                  <p class="font-semibold leading-snug">{study.title}</p>
                  <p class="mt-0.5 text-sm text-muted">{study.place}</p>
                  <p class="mt-1.5 text-sm leading-relaxed">{study.detail}</p>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3 class="rotulo">Cómo trabajo</h3>
          <dl class="mt-4 space-y-4">
            {
              profile.strengths.map((strength) => (
                <div>
                  <dt class="font-semibold">{strength.title}</dt>
                  <dd class="mt-0.5 text-sm leading-relaxed text-muted">{strength.body}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contacto" class="contacto">
    <div class="mx-auto flex max-w-6xl flex-col gap-8 px-4 py-16 sm:px-6 sm:py-20 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="contacto-rotulo">04 · Contacto</p>
        <h2 class="mt-3 text-[clamp(2rem,5vw,3.25rem)]">¿Hacemos algo <em>juntos</em>?</h2>
        <p class="mt-4 max-w-lg text-lg opacity-85">
          Busco proyectos donde aprender herramientas nuevas y aplicar lo que ya sé. Escribime y lo charlamos.
        </p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a href={`mailto:${profile.email}`} class="boton contacto-principal">{profile.email}</a>
        <a href={profile.github} class="boton contacto-secundario">github.com/{profile.githubHandle} <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .portada {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--borde);
    background-image: var(--franjas);
  }

  .sol {
    justify-self: center;
    width: min(70vw, 22rem);
    aspect-ratio: 1;
    padding: 2.5rem;
    border-radius: 999px;
    background: radial-gradient(circle, var(--superficie) 55%, transparent 71%);
  }

  .sol img {
    width: 100%;
    height: auto;
  }

  .chico {
    display: grid;
    gap: 0.35rem;
    height: 100%;
    padding: 1.35rem 1.4rem;
    border: 1px solid var(--borde);
    border-radius: var(--r-3);
    background: var(--superficie);
    box-shadow: var(--sombra-1);
    transition:
      border-color var(--d-1) var(--curva),
      transform var(--d-2) var(--curva);
  }

  .chico:hover {
    border-color: var(--acento-borde);
    transform: translateY(-2px);
  }

  .chico-mas {
    border-style: dashed;
    background: transparent;
    box-shadow: none;
  }

  .chico-nombre {
    font-family: var(--f-titulo);
    font-variation-settings: var(--f-titulo-ajustes);
    font-weight: 560;
    font-size: 1.4rem;
    line-height: 1.15;
  }

  .chico-lema {
    font-weight: 600;
  }

  .chico-texto {
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--texto-2);
  }

  .chico-stack {
    margin-top: 0.35rem;
    font-family: var(--f-mono);
    font-size: 0.75rem;
    color: var(--texto-3);
  }

  .franja {
    border-block: 1px solid var(--borde);
    background-color: var(--superficie-2);
  }

  .hito {
    width: 11px;
    height: 11px;
    rotate: 45deg;
    background: var(--destello);
    border: 1px solid var(--borde-fuerte);
  }

  /* Deep navy by day, Newell's red by night: always a fill with light letters. */
  .contacto {
    background: light-dark(var(--azul-noche), var(--rojo-boton));
    color: #ffffff;
  }

  .contacto h2 {
    color: #ffffff;
  }

  .contacto h2 em {
    color: light-dark(var(--celeste-claro), #ffffff);
  }

  .contacto-rotulo {
    font-family: var(--f-mono);
    font-size: var(--t-2xs);
    font-weight: 600;
    letter-spacing: var(--rotulo-tracking);
    text-transform: uppercase;
    color: light-dark(var(--celeste-claro), #ffffff);
  }

  .contacto-principal {
    background: #ffffff;
    border-color: #ffffff;
    color: light-dark(var(--azul-noche), var(--negro));
  }

  .contacto-secundario {
    background: transparent;
    border-color: rgb(255 255 255 / 0.45);
    color: #ffffff;
  }

  .contacto-secundario:hover {
    border-color: #ffffff;
  }
</style>
